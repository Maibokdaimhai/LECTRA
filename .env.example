# Local application profile. Copy to .env for local use only; replace placeholders.
# Cloud runtime receives these settings through environment/secrets, without .env.
# Runtime mode: development locally; production requires HTTPS APP_ORIGIN.
NODE_ENV=development
# Cloud Run supplies PORT. The API listens on 0.0.0.0; local default is 3001.
PORT=3001
# Exact browser origin, no trailing slash/path; production example: https://lectra.example.test
APP_ORIGIN=http://127.0.0.1:5173
# TCP PostgreSQL target; never commit an actual credential/connection string.
DATABASE_URL=postgresql://lectra:replace-me@127.0.0.1:55432/lectra_dev
# At least 32 cryptographically random bytes encoded as base64url; secret, server only.
SESSION_SECRET=replace-with-at-least-32-random-bytes-encoded-as-base64url
# none by default. Set 1 ONLY behind one controlled ingress hop that overwrites
# forwarded headers and has no bypass path. Required for secure cookies behind Cloud Run TLS.
TRUST_PROXY=none

# Vite development/preview server only, never a browser-exposed secret.
# API_PROXY_TARGET=http://127.0.0.1:3001

# Explicit operator commands only (not needed by the running app):
# Development forward migrations: must exactly match DATABASE_URL database name.
# ALLOW_DATABASE_MIGRATIONS=lectra_dev
# Production forward migrations/demo bootstrap: must exactly match target database.
# ALLOW_PRODUCTION_DATABASE=lectra_demo
# Separate demo-seed confirmation; seed is never automatic. Synthetic fixtures only.
# SEED_PRODUCTION_DEMO=lectra_demo
# Private distinct owner/respondent demo passwords, 12–128 code points; no defaults.
# SEED_OWNER_PASSWORD=replace-with-private-owner-password
# SEED_RESPONDENT_PASSWORD=replace-with-private-respondent-password

# Disposable test/verification settings (never set on the deployed app):
# TEST_DATABASE_URL=postgresql://lectra:replace-me@127.0.0.1:55432/lectra_test_example
# ALLOW_TEST_DATABASE=lectra_test_example
# DEVELOPMENT_DATABASE_URL=postgresql://lectra:replace-me@127.0.0.1:55432/lectra_dev
# SEED_SYNTHETIC_DATA=lectra_test_example
# ALLOW_FOUNDATION_TESTS=lectra_test_example
# ALLOW_FEATURE_TESTS=lectra_test_example
# ALLOW_RELEASE_TESTS=lectra_test_example
# ALLOW_POST_RELEASE_TESTS=lectra_test_example
# ALLOW_BROWSER_TESTS=lectra_test_example
# ALLOW_CLOUD_TESTS=lectra_test_example
# RESTART_PASSWORD=replace-with-the-private-feature-suite-password
# Tool-managed internally: PGOPTIONS=-c timezone=UTC (database subprocesses),
# PLAYWRIGHT_BROWSERS_PATH=.local/playwright-browsers (browser launcher).

# Episode 3 local Compose: generated privately by npm run setup:docker into
# .local/docker.env, NOT into this file. No committed fallback passwords.
# POSTGRES_PASSWORD=replace-with-private-url-safe-database-password
# WEB_PORT=5173
# API_PORT=3001
# API_IMAGE=lectra-api:episode3
# WEB_IMAGE=lectra-web:episode3
# The Docker browser verifier sets these internally; never deploy them:
# EP3_BASE_URL=http://127.0.0.1:5173
# EP3_EVIDENCE_DIR=.local/episode3/example/evidence
# EP3_BROWSER_STATE_FILE=.local/episode3/example/browser.json
# EP3_BROWSER_PHASE=before
