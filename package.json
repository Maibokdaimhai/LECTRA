{
  "name": "lectra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "24.22.1",
    "npm": "10.9.2"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:smoke": "node scripts/dev.mjs --smoke",
    "build": "npm run db:generate && npm run build --workspaces",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tooling.json",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:db": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "browsers:install": "node scripts/playwright.mjs install chromium",
    "test:e2e": "node scripts/playwright.mjs test",
    "check:orm": "node --env-file=.env.test.local --import tsx scripts/orm-smoke.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:test": "node --env-file=.env.test.local --import tsx scripts/database.ts migrate-test",
    "db:migrate:dev": "node --env-file=.env --import tsx scripts/database.ts migrate-dev",
    "db:seed:test": "node --env-file=.env.test.local --import tsx scripts/database.ts seed-test",
    "test:db:foundation": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.foundation.config.ts",
    "start": "node --env-file=.env apps/api/dist/server.js",
    "test:features": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.features.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
